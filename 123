-- บริการระบบ
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local isRunning = false

-- Remote สำหรับเก็บเงิน
local collectRemote = ReplicatedStorage:WaitForChild("Network")
    :WaitForChild("PlotService")
    :WaitForChild("RE")
    :WaitForChild("CollectBalance")

-- ลบ UI เก่าออกหากมีการรันซ้ำ
local GUI_NAME = "AnimeDice_CollectorUI"
if CoreGui:FindFirstChild(GUI_NAME) then
    CoreGui[GUI_NAME]:Destroy()
end

-- สร้าง ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = GUI_NAME
screenGui.ResetOnSpawn = false

-- ตรวจสอบสิทธิ์การเข้าถึง CoreGui
local success = pcall(function()
    screenGui.Parent = CoreGui
end)
if not success or not screenGui.Parent then
    screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

-- สร้างปุ่ม Toggle
local button = Instance.new("TextButton")
button.Name = "ToggleBtn"
button.Size = UDim2.new(0, 160, 0, 45)
button.Position = UDim2.new(0.05, 0, 0.45, 0)
button.BackgroundColor3 = Color3.fromRGB(220, 53, 69) -- สีแดง
button.Text = "Auto Collect: OFF"
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.Font = Enum.Font.GothamBold
button.TextSize = 14
button.Active = true
button.Draggable = true
button.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = button

-- ลูปการทำงานเบื้องหลัง
local function startLoop()
    while isRunning do
        pcall(function()
            collectRemote:FireServer(1)
        end)
        task.wait(0.5) -- หน่วงเวลา 0.5 วินาที
    end
end

-- ดักจับการกดปุ่ม
button.MouseButton1Click:Connect(function()
    isRunning = not isRunning

    if isRunning then
        button.Text = "Auto Collect: ON"
        button.BackgroundColor3 = Color3.fromRGB(40, 167, 69) -- สีเขียว
        task.spawn(startLoop)
    else
        button.Text = "Auto Collect: OFF"
        button.BackgroundColor3 = Color3.fromRGB(220, 53, 69) -- สีแดง
    end
end)
